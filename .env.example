# ─────────────────────────────────────────────────────────────────────────────
# Quovi — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs réelles.
# Ce fichier est versionné, .env.local ne l'est pas (cf .gitignore).
# ─────────────────────────────────────────────────────────────────────────────


# ╔═════════════════════════════════════════════════════════════════════════╗
# ║ App                                                                     ║
# ╚═════════════════════════════════════════════════════════════════════════╝

# URL publique de l'app (sans slash final). Sert aux callbacks Stripe, aux
# liens de signature client (/sign/[token]) et aux mails Resend.
# Dev : http://localhost:3000 — Prod : https://quovi.fr
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ╔═════════════════════════════════════════════════════════════════════════╗
# ║ Supabase (auth + base de données)                                       ║
# ║ Dashboard Supabase → Project Settings → API                             ║
# ╚═════════════════════════════════════════════════════════════════════════╝

# URL du projet (publique).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clé "anon public" — exposée côté client, sécurisée par les RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Clé "service_role" — SECRÈTE, bypasse les RLS. Jamais exposée au client.
# Utilisée côté serveur uniquement (lib/supabase/admin.ts) pour :
#   • mise à jour de la signature publique (page /sign/[token])
#   • webhook Resend qui marque les devis comme "viewed"
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ╔═════════════════════════════════════════════════════════════════════════╗
# ║ Stripe (paiement & abonnements)                                         ║
# ║ Dashboard Stripe → Developers → API keys                                ║
# ╚═════════════════════════════════════════════════════════════════════════╝

# Clé secrète serveur (sk_test_... en sandbox, sk_live_... en prod).
STRIPE_SECRET_KEY=sk_test_your-key-here

# Secret du webhook (Stripe → Developers → Webhooks → endpoint → Signing secret).
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# IDs des prix mensuels (Stripe → Products → prix → API ID, format price_...).
STRIPE_STARTER_MONTHLY_PRICE_ID=price_your-starter-id
STRIPE_PRO_MONTHLY_PRICE_ID=price_your-pro-id


# ╔═════════════════════════════════════════════════════════════════════════╗
# ║ Anthropic (Émile — Le Rédacteur de devis)                               ║
# ║ https://console.anthropic.com → API Keys                                ║
# ╚═════════════════════════════════════════════════════════════════════════╝

# Modèle utilisé : claude-sonnet-4-5 (voir app/api/emile/chat/route.ts).
ANTHROPIC_API_KEY=sk-ant-your-key-here


# ╔═════════════════════════════════════════════════════════════════════════╗
# ║ Resend (emails transactionnels)                                         ║
# ║ https://resend.com/api-keys                                             ║
# ╚═════════════════════════════════════════════════════════════════════════╝

# Clé API Resend (re_...).
RESEND_API_KEY=re_your-key-here

# Adresse "From" pour les emails ARTISAN → CLIENT (devis, confirmations
# signature). Le displayName visible côté client est toujours le nom de
# l'entreprise artisan ; cette adresse est uniquement technique.
# Dev : onboarding@resend.dev — Prod : devis@quovi.fr (domaine vérifié).
RESEND_FROM_EMAIL=devis@quovi.fr

# Adresse "From" pour les emails QUOVI → ARTISAN (welcome, notifications
# de signature reçue, alertes). Séparée pour éviter de polluer la réputation
# du domaine de devis.
# Dev : onboarding@resend.dev — Prod : hello@quovi.fr
RESEND_QUOVI_FROM_EMAIL=hello@quovi.fr

# Secret du webhook Resend (Resend Dashboard → Webhooks → Signing secret).
# Sert à vérifier les events email.opened / email.delivered / email.bounced.
# URL à configurer dans Resend : <NEXT_PUBLIC_APP_URL>/api/webhooks/resend
RESEND_WEBHOOK_SECRET=whsec_your-resend-webhook-secret


# ╔═════════════════════════════════════════════════════════════════════════╗
# ║ OpenAI (Whisper — dictée vocale Émile, V2)                              ║
# ╚═════════════════════════════════════════════════════════════════════════╝

# Optionnel : utilisé par /api/whisper pour la transcription vocale.
# La feature est désactivée par défaut (VoiceButton disabled). Activer en V2.
# OPENAI_API_KEY=sk-your-openai-key


# ╔═════════════════════════════════════════════════════════════════════════╗
# ║ Monitoring (optionnel)                                                  ║
# ╚═════════════════════════════════════════════════════════════════════════╝

# Aucun monitoring branché pour l'instant. Si besoin plus tard :
# SENTRY_DSN=https://xxx@sentry.io/xxx
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
